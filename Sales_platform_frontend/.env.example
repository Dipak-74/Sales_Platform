# Backend API Base URL (Deployed Spring Boot on Render)
VITE_API_URL=https://sales-platform-backend.onrender.com

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Supabase Storage Configuration (for product image uploads)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_BUCKET=Sales-Platform_product-images

# Cashfree Payment Gateway Mode (optional: sandbox / production)
VITE_CASHFREE_MODE=sandbox

